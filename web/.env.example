# Resend: OTP, welcome, contact form
RESEND_API_KEY=replace-with-a-resend-api-key
RESEND_FROM=Market Tide <brief@markettide.in>
REPLY_TO_EMAIL=market.tide27@gmail.com

# Substack: Daily Brief signup and manual bulk delivery
# Defaults to Market Tide's publication; override only for another publication.
NEXT_PUBLIC_SUBSTACK_URL=https://markettide.substack.com
NEWSLETTER_DELIVERY=substack

# Existing storage/authentication
MONGODB_URI=replace-with-your-mongodb-uri
MONGODB_DB=market_tide
AUTH_SECRET=replace-with-a-long-random-secret
SEND_WELCOME_EMAILS=false
KV_REST_API_URL=replace-with-your-upstash-rest-url
KV_REST_API_TOKEN=replace-with-your-upstash-rest-token

# Private operations dashboard
ADMIN_PATH_TOKEN=replace-with-a-long-random-url-token
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-secret
